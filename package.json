{
	"name": "pi-claude-cross-session",
	"version": "0.1.0",
	"type": "module",
	"description": "Cross-session messaging between pi and Claude Code: identical ListAgents/SendMessage tools over Claude Code's native peer protocol",
	"keywords": [
		"pi-package",
		"pi-extension",
		"claude-code",
		"cross-session-messaging"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"index.ts",
		"peer.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "22.19.19",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write --error-on-warnings . && npm run typecheck && npm run test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/utopia2077/pi-claude-cross-session.git"
	},
	"bugs": {
		"url": "https://github.com/utopia2077/pi-claude-cross-session/issues"
	},
	"homepage": "https://github.com/utopia2077/pi-claude-cross-session"
}
